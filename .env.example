# escort5-auto - miljovariabler
# Kopier til .env og udfyld med rigtige vaerdier. .env er git-ignoreret.

# --- ASP.NET admin-login (Playwright) ---
LOGIN_URL=https://escort5.dk/login
ADMIN_URL=https://escort5.dk/admin/topics
SITE_URL=https://escort5.dk/
USERNAME=
PASSWORD=

# --- Claude API (artikelgenerering) ---
ANTHROPIC_API_KEY=

# --- Pexels (billeder) ---
PEXELS_API_KEY=

# --- Google service-account (Search Console + valgfrit GA4) ---
# Sti til JSON-noeglefilen, fx ./google-credentials.json
GOOGLE_CREDENTIALS=./google-credentials.json

# --- GA4 (valgfrit) ---
# Numerisk GA4 property-id (IKKE "properties/..."), fx 123456789.
# Service-accounten fra GOOGLE_CREDENTIALS skal tilfojes som "Viewer" i
# GA4 -> Admin -> Adgangsstyring for ejendommen, foerst da virker det.
# Sat den ikke, koerer auto.js videre uden GA4-bonus, som foer.
GOOGLE_ANALYTICS_PROPERTY_ID=

# --- Telegram bot ---
TELEGRAM_TOKEN=
# Dit personlige chat-id - brug /chatid i botten for at finde det.
# Bruges KUN til at sende autopilot-statusbeskeder; autopilot koerer uanset.
TELEGRAM_CHAT_ID=

# --- Autopilot (automatisk artikel-generering, se bot.js) ---
# AUTO_ENABLED=false slaar den planlagte koersel helt fra
AUTO_ENABLED=true
# Cron-udtryk, Europe/Copenhagen tid. Default: hver dag kl. 08:00
AUTO_CRON=0 8 * * *
# Antal artikler pr. planlagt koersel
AUTO_ANTAL=1
